# JARVIS server configuration. Copy to `.env` (git-ignored) and adjust.

# Interface the API binds to. Keep 127.0.0.1 — JARVIS has no user authentication yet.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=4310

# Port of the Vite dev server, and the API URL it proxies /api to (only needed when changing ports).
# JARVIS_WEB_PORT=5173
# JARVIS_API_URL=http://127.0.0.1:4310

# Origin allowed to call the API (the Vite dev server by default).
JARVIS_WEB_ORIGIN=http://localhost:5173

# Directory for local state (encrypted credentials, saved queries, history).
# Defaults to ~/.jarvis when unset.
# JARVIS_DATA_DIR=

# 32-byte key (base64 or 64 hex chars) used to encrypt stored connection passwords.
# When unset, JARVIS generates one into <data dir>/secret.key with 0600 permissions.
# JARVIS_SECRET_KEY=

# Time limit, in milliseconds, for queries run from the query builder.
# JARVIS_QUERY_TIMEOUT_MS=30000

# debug | info | warn | error
JARVIS_LOG_LEVEL=info
