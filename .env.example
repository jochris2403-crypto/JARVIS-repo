# JARVIS server configuration. Copy to `.env` (git-ignored) and adjust.

# Interface the API binds to. 127.0.0.1 = this machine only (no login needed).
# Use 0.0.0.0 to allow other machines; JARVIS then requires JARVIS_AUTH_PASSWORD.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=4310
# (When JARVIS_PORT is unset, the PORT variable set by hosting platforms is used.)

# Port of the Vite dev server, and the API URL it proxies /api to (only needed when changing ports).
# JARVIS_WEB_PORT=5173
# JARVIS_API_URL=http://127.0.0.1:4310

# Origin allowed to call the API (the Vite dev server by default).
JARVIS_WEB_ORIGIN=http://localhost:5173

# Directory for local state (encrypted credentials, saved queries, history).
# Defaults to ~/.jarvis when unset.
# JARVIS_DATA_DIR=

# 32-byte key (base64 or 64 hex chars) used to encrypt stored connection passwords.
# When unset, JARVIS generates one into <data dir>/secret.key with 0600 permissions.
# JARVIS_SECRET_KEY=

# Time limit, in milliseconds, for queries run from the query builder.
# JARVIS_QUERY_TIMEOUT_MS=30000

# debug | info | warn | error
JARVIS_LOG_LEVEL=info

# ── Access from other machines (see DEPLOYMENT.md) ────────────────────────────
# Sign-in account. Setting a password turns the login screen on (min. 8 characters).
# JARVIS_AUTH_USERNAME=admin
# JARVIS_AUTH_PASSWORD=

# URL(s) people type to open JARVIS, comma-separated. Requests addressed to any other
# host are rejected. Render, Railway and Fly URLs are detected automatically.
# JARVIS_PUBLIC_ORIGIN=http://192.168.1.20:4310,https://jarvis.example.com

# How long a sign-in lasts, in hours.
# JARVIS_SESSION_TTL_HOURS=12

# Number of reverse proxies in front of JARVIS (1 on Render/Railway/Fly/nginx). Leave
# unset when browsers connect to JARVIS directly.
# JARVIS_TRUST_PROXY=1
